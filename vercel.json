{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/about-me", "destination": "/votre-coach-et-sophrologie/", "permanent": true },
    { "source": "/about-me/", "destination": "/votre-coach-et-sophrologie/", "permanent": true },
    { "source": "/skt-coach", "destination": "/", "permanent": true },
    { "source": "/skt-coach/", "destination": "/", "permanent": true },
    { "source": "/get-fit", "destination": "/prenez-rendez-vous/", "permanent": true },
    { "source": "/get-fit/", "destination": "/prenez-rendez-vous/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
